create or replace   view DBT_DEMO.RAW_staging.stg_customers
  
   as (
    with source as (
    select * from DBT_DEMO.RAW.customers
),

renamed as (
    select
        customer_id,
        first_name,
        last_name,
        first_name || ' ' || last_name as full_name,
        email,
        country,
        created_at as customer_created_at
    from source
)

