[0m07:32:56.422469 [debug] [Thread-3 (]: On model.dbt_demo.fct_order_lines: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "dbt_demo", "target_name": "dev", "node_id": "model.dbt_demo.fct_order_lines"} */
create or replace transient table DBT_DEMO.RAW_marts.fct_order_lines
         as
        (with orders as (
    select * from DBT_DEMO.RAW_staging.stg_orders
),

order_items as (
    select * from DBT_DEMO.RAW_staging.stg_order_items
),

products as (
    select * from DBT_DEMO.RAW_staging.stg_products
),

final as (
    select
        oi.order_item_id,
        o.order_id,
        o.customer_id,
        o.order_date,
        o.order_status,
        oi.product_id,
        p.product_name,
        p.category,
        oi.quantity,
        p.unit_price,
        oi.quantity * p.unit_price as line_total
    from orders o
    join order_items oi on o.order_id = oi.order_id
    join products p on oi.product_id = p.product_id
)

select * from final
        );
[0m07:32:56.423170 [debug] [Thread-4 (]: On model.dbt_demo.dim_customers: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "dbt_demo", "target_name": "dev", "node_id": "model.dbt_demo.dim_customers"} */
create or replace transient table DBT_DEMO.RAW_marts.dim_customers
         as
        (with customers as (
    select * from DBT_DEMO.RAW_staging.stg_customers
),

orders as (
    select * from DBT_DEMO.RAW_staging.stg_orders
),

order_items as (
    select * from DBT_DEMO.RAW_staging.stg_order_items
),

products as (
    select * from DBT_DEMO.RAW_staging.stg_products
),

order_totals as (
    select
        o.order_id,
        o.customer_id,
        o.order_date,
        o.order_status,
        sum(oi.quantity * p.unit_price) as order_total
    from orders o
    join order_items oi on o.order_id = oi.order_id
    join products p on oi.product_id = p.product_id
    group by 1, 2, 3, 4
),

customer_metrics as (
    select
        c.customer_id,
        c.full_name,
        c.email,
        c.country,
        c.customer_created_at,
        count(distinct ot.order_id) as total_orders,
        coalesce(sum(ot.order_total), 0) as lifetime_value,
        min(ot.order_date) as first_order_date,
        max(ot.order_date) as last_order_date
    from customers c
    left join order_totals ot on c.customer_id = ot.customer_id
    group by 1, 2, 3, 4, 5
)

select * from customer_metrics
        );
